# Firebase (arquivo local OU JSON completo no CI)
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT continua aceito como alias legado.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIRESTORE_DATABASE_ID=default

# Comic Vine — fonte primária
COMIC_VINE_API_KEY=
COMIC_VINE_USER_AGENT=MarvelMultiverseQuizGenerator/1.0
COMIC_VINE_PAGE_SIZE=100
COMIC_VINE_MAX_PAGES=3
COMIC_VINE_REQUEST_INTERVAL=1.1

# IA — padrão reaproveitado conceitualmente do "Projeto de IA"
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# AI_API_KEY também é aceito como alias de GROQ_API_KEY.
AI_BATCH_SIZE=10
AI_MAX_RETRIES=3

# Pesquisa web opcional: none ou tavily
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
# TAVILY_API_KEY também é aceito como alias.
WEB_TRUSTED_DOMAINS=marvel.com
WEB_MAX_RESULTS=5

APP_TIMEZONE=America/Sao_Paulo
